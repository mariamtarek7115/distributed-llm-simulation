# -----------------------------
# WORKER ENDPOINTS
# -----------------------------
# Each worker needs:
# - OLLAMA_WORKER_URL_n: inference endpoint used for generation
# - OLLAMA_WORKER_HEALTH_URL_n: heartbeat endpoint used to detect recovery
# - WORKER_METRICS_URL_n: metrics endpoint used by the load-aware strategy

# Worker 0
OLLAMA_WORKER_URL_0=https://rylpy7xf-11434.thundercompute.net/api/generate
OLLAMA_WORKER_HEALTH_URL_0=https://rylpy7xf-8080.thundercompute.net/health
WORKER_METRICS_URL_0=http://127.0.0.1:9090/metrics

# Worker 1
OLLAMA_WORKER_URL_1=https://q7p2g7xn-11434.thundercompute.net/api/generate
OLLAMA_WORKER_HEALTH_URL_1=https://q7p2g7xn-8080.thundercompute.net/health
WORKER_METRICS_URL_1=http://127.0.0.1:9091/metrics

# Worker 2
OLLAMA_WORKER_URL_2=https://4oz8qfgr-11434.thundercompute.net/api/generate
OLLAMA_WORKER_HEALTH_URL_2=https://4oz8qfgr-8080.thundercompute.net/health
WORKER_METRICS_URL_2=http://127.0.0.1:9092/metrics

# Worker 3
OLLAMA_WORKER_URL_3=https://rgj32uoc-11434.thundercompute.net/api/generate
OLLAMA_WORKER_HEALTH_URL_3=https://rgj32uoc-8080.thundercompute.net/health
WORKER_METRICS_URL_3=http://127.0.0.1:9093/metrics

# -----------------------------
# MODEL AND LOAD BALANCING
# -----------------------------
# OLLAMA_MODEL: model name sent to /api/generate
# LOAD_BALANCER_STRATEGY options:
# - round_robin: rotate through alive workers in order, regardless of load
# - least_connections: choose the node with the fewest active assigned requests
# - load_aware: choose by lowest GPU usage, then CPU usage, then active requests
OLLAMA_MODEL=tinyllama
LOAD_BALANCER_STRATEGY=round_robin

# -----------------------------
# TEST SCENARIO
# -----------------------------
# SCENARIO options:
# - normal: baseline run with all workers available
# - random_failures: simulate worker failures and reroute work to other alive workers
# - node_down_recovery: drop one chosen worker, keep it unhealthy, then restore it later
# - all_nodes_down: simulate total outage and return a safe fallback response
SCENARIO=normal

# Load generation settings
# NUM_USERS: total number of requests/users to simulate
# CONCURRENCY: maximum number of concurrent in-flight requests
NUM_USERS=100
CONCURRENCY=20

# Failure and recovery settings
# FAILURE_RATE: probability used by the random_failures scenario
# RECOVERY_TIME: seconds before an unhealthy node is restored
FAILURE_RATE=0.2
RECOVERY_TIME=10

# Node-down recovery controls, used only when SCENARIO=node_down_recovery
# NODE_DOWN_WORKER_INDEX: which worker to drop, zero-based
# NODE_DOWN_AFTER_SECONDS: when to mark that worker unhealthy
# NODE_RECOVERY_AFTER_SECONDS: when to allow it to receive tasks again
NODE_DOWN_WORKER_INDEX=0
NODE_DOWN_AFTER_SECONDS=20
NODE_RECOVERY_AFTER_SECONDS=30

# Total-outage controls, used only when SCENARIO=all_nodes_down
# ALL_NODES_DOWN_AFTER_SECONDS: when to mark all workers unhealthy
# ALL_NODES_RECOVERY_AFTER_SECONDS: when to recover all workers again, 0 keeps them down
ALL_NODES_DOWN_AFTER_SECONDS=10
ALL_NODES_RECOVERY_AFTER_SECONDS=20

# -----------------------------
# SCHEDULER AND RETRY TUNING
# -----------------------------
# MAX_WORKERS: main dispatcher tasks
# QUEUE_SIZE: request queue capacity
# RETRY_WORKERS: retry dispatcher tasks
# MAX_RETRIES: max retry attempts per request
# REQUEST_TIMEOUT: timeout per request in seconds
MAX_WORKERS=4
QUEUE_SIZE=50
RETRY_WORKERS=2
MAX_RETRIES=2
REQUEST_TIMEOUT=120